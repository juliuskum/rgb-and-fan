<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>LichtLuefter</AssemblyName>
    <RootNamespace>LichtLuefter</RootNamespace>
    <Product>Licht &amp; Lüfter</Product>
    <Version>1.0.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- WebView2 bringt einen ungenutzten WPF-Teil mit, der einen WindowsBase-Versionskonflikt meldet. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\LichtLuefter.Core\LichtLuefter.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
  <ItemGroup>
    <None Include="ui\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
